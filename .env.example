# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Market data
OILPRICEAPI_KEY=

# AI providers (free-first — configure any subset)
# Gemini remains provider #1 when available
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # optional alias for GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter free models — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://midnight-society.local
OPENROUTER_APP_NAME=Midnight Society

# Optional provider order / retry tuning
AI_PROVIDER_ORDER=GEMINI,GROQ,OPENROUTER
AI_PROVIDER_MAX_RETRIES=1
