# Telegram (SECRET)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional dedicated TEST destination for Cloudflare live send tests (SECRET)
# Do NOT set this to the production Midnight Society channel during development.
TELEGRAM_TEST_CHANNEL_ID=
# TELEGRAM_TEST_CHAT_ID=

# Human pacing for the channel (PLAIN CONFIG)
TELEGRAM_MAX_POSTS_PER_JOB=1
TELEGRAM_MIN_MINUTES_BETWEEN_POSTS=10

# Market data (SECRET)
OILPRICEAPI_KEY=

# AI providers — free-first failover (SECRET keys / PLAIN model names)
# Order: Gemini → Groq → OpenRouter free → Cloudflare Workers AI → rule fallback
# Pipeline never stops: if all LLMs fail, RULE_FALLBACK still analyzes.

# 1) Google AI Studio (free tier) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # optional alias for GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# 2) Groq free tier (fast) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 3) OpenRouter free models — https://openrouter.ai/keys
# Uses openrouter/free + :free model cascade (paid models rejected)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://midnight-society.local
OPENROUTER_APP_NAME=Midnight Society

# 4) Cloudflare Workers AI — no key; enabled via wrangler [ai] binding
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional provider order / retry tuning (PLAIN CONFIG)
AI_PROVIDER_ORDER=GEMINI,GROQ,OPENROUTER,CLOUDFLARE
AI_PROVIDER_MAX_RETRIES=1

# Cloudflare Worker bounds (PLAIN CONFIG / OPTIONAL)
CF_MAX_RSS_SOURCES=24
CF_MAX_NEW_EVENTS=5
CF_MAX_AI_CALLS=3
CF_MAX_MARKET_EVENTS=10
CF_MAX_SYMBOLS_PER_EVENT=4

# Explicit production Telegram send gate (PLAIN CONFIG)
# Leave unset/false until a dedicated test destination has been verified.
CF_ALLOW_PRODUCTION_TELEGRAM=false
